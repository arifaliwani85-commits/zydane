# Public URL of the store (used for Stripe redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Card payments (Stripe). Leave empty to switch card payments off.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (for sending paid AliDropship orders to the back office)
STRIPE_WEBHOOK_SECRET=

# AliDropship back office (WooCommerce on admin.zydane.com). Leave empty to use the built-in catalogue only.
WC_URL=https://admin.zydane.com
WC_KEY=
WC_SECRET=

# PayPal (REST app credentials from developer.paypal.com → Apps & Credentials).
# Leave empty to switch PayPal off. With neither Stripe nor PayPal set, checkout runs in test mode and takes no money.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set to "sandbox" while testing with PayPal sandbox credentials; leave out for live payments.
PAYPAL_ENV=
